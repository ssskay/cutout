<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Cutout is deliberately offline. There is NO com.apple.security.network.client
	  entitlement here and there never should be: with the App Sandbox on, the
	  kernel refuses outbound connections rather than trusting us to not make any.
	  If a future change appears to need networking, the change is wrong.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Files the user drops on the window or picks in a panel. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Remember the chosen export folder across launches (security-scoped bookmark). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
